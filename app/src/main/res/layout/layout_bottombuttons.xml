<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        >

    <data>
        <variable
            name="bottom_bar_click_listener"
            type="android.view.View.OnClickListener"/>
        <variable
            name="uimodel"
            type="com.particlesdevs.photoncamera.ui.camera.model.CameraFragmentModel"/>
        <variable
            name="timermodel"
            type="com.particlesdevs.photoncamera.ui.camera.model.TimerFrameCountModel"/>
        <variable
            name="uicontroller"
            type="com.particlesdevs.photoncamera.ui.camera.CameraUIController"/>
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            >

        <FrameLayout
                android:id="@+id/camera_switch_container"
                android:layout_width="@dimen/camera_switch_button_size"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="1.0"
                app:layout_constraintEnd_toStartOf="@+id/shutter_button_container"
                app:layout_constraintHorizontal_bias="0.0"
                android:layout_marginStart="25dp"
                app:layout_constraintHorizontal_chainStyle="spread_inside"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                    android:layout_gravity="center"
                    android:id="@+id/flip_camera_button"
                    android:background="#00000000"
                    android:clickable="true"
                    android:onClick="@{bottom_bar_click_listener}"
                    android:onLongClick="@{() -> uimodel.onFlipCameraLongClicked(flipCameraButton, uicontroller)}"
                    android:contentDescription="Lens Switch Button"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_flip_camera"
                    android:textAppearance="@style/TextAppearance.AppCompat"
                    android:visibility="visible"
                    tools:ignore="HardcodedText"
                    android:layout_height="match_parent"
                    android:layout_width="match_parent"/>

        </FrameLayout>

        <FrameLayout
                android:id="@+id/toggle_framecount_slider_container"
                android:layout_width="40dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="1.0"
                app:layout_constraintEnd_toStartOf="@+id/shutter_button_container"
                app:layout_constraintStart_toEndOf="@+id/camera_switch_container"
                app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                    android:id="@+id/toggleFrameCountSlider"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/toggle_button_background"
                    android:selected="@{uimodel.frameCountSliderVisible}"
                    app:tint="@color/black_white_selectable"
                    android:clickable="true"
                    android:contentDescription="Toggle Frame Count Slider"
                    android:onClick="@{bottom_bar_click_listener}"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_burst_mode_black_24dp"
                    app:bindRotate="@{uimodel}" />

        </FrameLayout>

        <FrameLayout
                android:id="@+id/toggle_zoom_slider_container"
                android:layout_width="40dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="1.0"
                app:layout_constraintEnd_toStartOf="@+id/shutter_button_container"
                app:layout_constraintStart_toEndOf="@+id/camera_switch_container"
                app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                    android:id="@+id/toggleZoomSlider"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/toggle_button_background"
                    android:selected="@{uimodel.zoomSliderVisible}"
                    app:tint="@color/black_white_selectable"
                    android:clickable="true"
                    android:contentDescription="Toggle Zoom Slider"
                    android:onClick="@{bottom_bar_click_listener}"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/zoom_in_24px"
                    app:bindRotate="@{uimodel}" />

        </FrameLayout>

        <FrameLayout
                android:layout_width="@dimen/shutter_button_size"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="1.0"
                android:id="@+id/shutter_button_container"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@+id/camera_switch_container"
                app:layout_constraintEnd_toStartOf="@id/galery_button_container"
                app:layout_constraintBottom_toBottomOf="parent" >

            <ImageButton
                    android:id="@+id/shutter_button"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/shutter_button_main"
                    android:clickable="true"
                    android:contentDescription="Shutter Button"
                    android:onClick="@{bottom_bar_click_listener}"
                    android:scaleX="0.75"
                    android:scaleY="0.75"
                    android:textAppearance="@style/TextAppearance.AppCompat"
                    android:visibility="visible"
                    app:bindRotate="@{uimodel}"
                    tools:ignore="HardcodedText"
                    tools:text="Shot" />

            <ProgressBar
                    android:id="@+id/processing_progress_bar"
                    style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:indeterminate="false"
                    android:max="100"
                    tools:progress="50"
                    android:progressDrawable="@drawable/circular_progress_bar2"
                    android:indeterminateBehavior="cycle"
                    android:indeterminateDuration="2000"
                    android:indeterminateDrawable="@drawable/circular_progress_bar2"
                    android:interpolator="@android:anim/accelerate_decelerate_interpolator"
                    android:scaleX="1.35"
                    android:scaleY="1.35" />

            <TextView
                    android:id="@+id/frameCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="25"
                    android:text="@{timermodel.frameCount}"
                    android:textColor="@android:color/white"
                    android:textSize="34sp"
                    android:textAlignment="center"
                    android:typeface="normal"
                    android:visibility="visible"
                    android:layout_gravity="center"
                    app:bindRotate="@{uimodel}" />
        </FrameLayout>

        <FrameLayout
                android:id="@+id/toggle_hdr_container"
                android:layout_width="40dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="1.0"
                app:layout_constraintEnd_toStartOf="@+id/galery_button_container"
                app:layout_constraintStart_toEndOf="@+id/shutter_button_container"
                app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                    android:id="@+id/toggleHdr"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/toggle_button_background"
                    android:selected="@{uimodel.hdrOn}"
                    app:tint="@color/black_white_selectable"
                    android:clickable="true"
                    android:contentDescription="Ultra_HDR_On"
                    android:onClick="@{bottom_bar_click_listener}"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/hdr_on_24px"
                    app:bindRotate="@{uimodel}" />

        </FrameLayout>

        <FrameLayout
                android:layout_width="@dimen/gallery_button_size"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="1.0"
                android:id="@+id/galery_button_container"
                android:layout_marginEnd="25dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/shutter_button_container" >

            <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/gallery_image_button"
                    android:layout_gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/round"
                    app:civ_border_color="@color/Light"
                    app:civ_border_overlay="true"
                    app:civ_border_width="3dp"
                    android:onClick="@{bottom_bar_click_listener}"
                    android:onLongClick="@{() -> uimodel.onGalleryLongClicked(galleryImageButton, uicontroller)}"
                    imageFromBitmap="@{uimodel.bitmap}"
                    bindRotate="@{uimodel}" />
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>