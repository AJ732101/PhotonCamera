<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <data>
        <import type="android.view.View" />
        <variable
            name="uimodel"
            type="com.particlesdevs.photoncamera.ui.camera.model.CameraFragmentModel" />
        <variable
            name="auxmodel"
            type="com.particlesdevs.photoncamera.ui.camera.model.AuxButtonsModel" />
        <variable
            name="zoom_slider_visible"
            type="boolean"/>
        <variable
            name="framecount_slider_visible"
            type="boolean"/>
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/textureHolder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateLayoutChanges="true"
        android:background="?cameraFragmentBackground">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/camera_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:animateLayoutChanges="true"
            app:adjustCameraContainer="@{uimodel.screenAspectRatio}"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layout_topbar">

            <include
                android:id="@+id/layout_viewfinder"
                layout="@layout/layout_main_viewfinder"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintBaseline_toBottomOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.0"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/recording_timer_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="70dp"
                android:background="@drawable/aux_container_background"
                android:drawablePadding="8dp"
                android:elevation="10dp"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="00:00"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:bindRotate="@{uimodel}"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/ten_bit_indicator_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:background="@drawable/aux_container_background"
                android:drawablePadding="8dp"
                android:elevation="10dp"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp"
                android:text="10Bit"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:bindRotate="@{uimodel}"
                app:layout_constraintBottom_toBottomOf="@+id/recording_timer_text"
                app:layout_constraintEnd_toStartOf="@+id/recording_timer_text"
                app:layout_constraintTop_toTopOf="@+id/recording_timer_text"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/hdr_indicator_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:background="@drawable/aux_container_background"
                android:drawablePadding="8dp"
                android:elevation="10dp"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="HDR"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:bindRotate="@{uimodel}"
                app:layout_constraintBottom_toBottomOf="@+id/recording_timer_text"
                app:layout_constraintStart_toEndOf="@+id/recording_timer_text"
                app:layout_constraintTop_toTopOf="@+id/recording_timer_text"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/recording_size_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/aux_container_background"
                android:drawablePadding="8dp"
                android:elevation="10dp"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="0MB"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:bindRotate="@{uimodel}"
                app:layout_constraintBottom_toBottomOf="@+id/aux_buttons_container"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/aux_buttons_container"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/current_shutter_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:background="@drawable/aux_container_background"
                android:drawablePadding="8dp"
                android:elevation="10dp"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="1/100s"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:bindRotate="@{uimodel}"
                app:layout_constraintBottom_toBottomOf="@+id/aux_buttons_container"
                app:layout_constraintEnd_toStartOf="@+id/recording_size_text"
                app:layout_constraintTop_toTopOf="@+id/recording_size_text"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/current_iso_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:background="@drawable/aux_container_background"
                android:drawablePadding="8dp"
                android:elevation="10dp"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="ISO100"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:bindRotate="@{uimodel}"
                app:layout_constraintBottom_toBottomOf="@+id/aux_buttons_container"
                app:layout_constraintStart_toEndOf="@+id/recording_size_text"
                app:layout_constraintTop_toTopOf="@+id/recording_size_text"
                tools:visibility="visible" />

            <ToggleButton
                android:id="@+id/buttonMagnifyViewfinder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/aux_container_background"
                android:checked="@{uimodel.viewfinderMagnified}"
                android:textColor="@{uimodel.isViewfinderMagnified ? 0xFF00FF00 : 0xFFFF0000}"
                android:textOn="1x VF"
                android:textOff="4x VF"
                app:bindRotate="@{uimodel}"
                android:onClick="@{() -> uimodel.onMagnifyViewfinderClicked()}"
                android:onLongClick="@{() -> uimodel.onMagnifierLongClicked(buttonMagnifyViewfinder)}"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="@+id/aux_buttons_container"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/aux_buttons_container" />

            <ToggleButton
                android:id="@+id/buttonFunctionOne"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/aux_container_background"
                android:checked="@{uimodel.isFunctionOneOn}"
                android:textColor="@{uimodel.isFunctionOneOn ? 0xFF00FF00 : 0xFFFF0000}"
                android:textOn="Fn1 ON"
                android:textOff="Fn1 OFF"
                app:bindRotate="@{uimodel}"
                android:onClick="@{() -> uimodel.onFunctionOneClicked()}"
                android:onLongClick="@{() -> uimodel.onFunctionOneLongClicked(buttonFunctionOne)}"
                android:layout_marginBottom="45dp"
                app:layout_constraintStart_toStartOf="@+id/buttonMagnifyViewfinder"
                app:layout_constraintEnd_toEndOf="@+id/buttonMagnifyViewfinder"
                app:layout_constraintBottom_toTopOf="@+id/buttonMagnifyViewfinder" />

            <ToggleButton
                android:id="@+id/buttonFunctionTwo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/aux_container_background"
                android:checked="@{uimodel.isFunctionTwoOn}"
                android:textColor="@{uimodel.isFunctionTwoOn ? 0xFF00FF00 : 0xFFFF0000}"
                android:textOn="Fn2 ON"
                android:textOff="Fn2 OFF"
                app:bindRotate="@{uimodel}"
                android:onClick="@{() -> uimodel.onFunctionTwoClicked()}"
                android:onLongClick="@{() -> uimodel.onFunctionTwoLongClicked(buttonFunctionTwo)}"
                android:layout_marginBottom="45dp"
                app:layout_constraintStart_toStartOf="@+id/buttonFunctionOne"
                app:layout_constraintEnd_toEndOf="@+id/buttonFunctionOne"
                app:layout_constraintBottom_toTopOf="@+id/buttonFunctionOne" />

            <FrameLayout
                android:id="@+id/zoom_value_container"
                android:layout_width="wrap_content"
                android:layout_height="330dp"
                android:layout_marginBottom="18dp"
                android:visibility="@{zoom_slider_visible ? View.VISIBLE : View.GONE}"
                app:layout_constraintBottom_toTopOf="@+id/aux_buttons_container"
                app:layout_constraintEnd_toEndOf="@+id/aux_buttons_container"
                app:layout_constraintStart_toStartOf="@+id/aux_buttons_container">

                <TextView
                    android:id="@+id/zoom_value_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal|top"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/aux_container_background"
                    android:elevation="10dp"
                    android:paddingStart="8dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="4dp"
                    android:text="@{String.format(java.util.Locale.US, `%.1fx`, uimodel.zoomLevel)}"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:bindRotate="@{uimodel}"
                    tools:text="1.00x" />

                <SeekBar
                    android:id="@+id/zoom_value"
                    android:layout_width="240dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:max="100"
                    android:progress="@{uimodel.zoomProgress}"
                    android:min="5"
                    android:rotation="270"
                    android:onSeekBarChangeListener="@{uimodel.zoomChangeListener}"
                    android:thumb="@drawable/seekbar_thumb_large" />

            </FrameLayout>

            <FrameLayout
                android:id="@+id/framecount_value_container"
                android:layout_width="wrap_content"
                android:layout_height="330dp"
                android:layout_marginBottom="18dp"
                android:visibility="@{framecount_slider_visible ? View.VISIBLE : View.GONE}"
                app:layout_constraintBottom_toTopOf="@+id/aux_buttons_container"
                app:layout_constraintEnd_toEndOf="@+id/aux_buttons_container"
                app:layout_constraintStart_toStartOf="@+id/aux_buttons_container">

                <TextView
                    android:id="@+id/framecount_value_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal|top"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/aux_container_background"
                    android:elevation="10dp"
                    android:paddingStart="8dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="4dp"
                    android:text="@{String.format(java.util.Locale.US, `Fr:%d`, uimodel.frameCount)}"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:bindRotate="@{uimodel}"
                    tools:text="1.00x" />

                <SeekBar
                    android:id="@+id/framecount_value"
                    android:layout_width="240dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:max="30"
                    android:progress="@{uimodel.frameCount}"
                    android:min="2"
                    android:rotation="270"
                    android:onSeekBarChangeListener="@{uimodel.frameCountChangeListener}"
                    android:thumb="@drawable/seekbar_thumb_large" />

            </FrameLayout>

            <FrameLayout
                android:id="@+id/dummy_reference_view"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:clickable="false"
                app:layout_constraintBaseline_toBottomOf="parent"
                app:layout_constraintDimensionRatio="3:4"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.0"
                tools:visibility="visible" />

            <com.particlesdevs.photoncamera.ui.camera.views.AuxButtonsLayout
                android:id="@+id/aux_buttons_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/aux_container_margin"
                android:layout_marginBottom="6dp"
                android:background="@drawable/aux_container_background"
                android:orientation="vertical"
                app:bindViewGroupChildrenRotate="@{uimodel}"
                app:layout_constraintBottom_toTopOf="@+id/manual_mode"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.97"
                app:setActiveId="@{auxmodel.currentCameraId}"
                app:setAuxButtonModel="@{auxmodel}"
                tools:layout_height="100dp"
                tools:layout_width="50dp" />

            <include
                android:id="@+id/manual_mode"
                layout="@layout/manual_palette"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@+id/layout_bottombar"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintVertical_bias="1.0"
                tools:visibility="visible" />

            <ImageView
                android:id="@+id/open_close_manual"
                android:layout_width="@dimen/arrow_size"
                android:layout_height="@dimen/arrow_size"
                android:layout_marginBottom="8dp"
                android:background="@drawable/chevron_up"
                android:contentDescription="Arrow"
                android:visibility="visible"
                app:layout_constraintBottom_toTopOf="@id/layout_bottombar"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <include
                android:id="@+id/layout_bottombar"
                layout="@layout/layout_main_bottombar"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/dummy_reference_view" />

            <com.particlesdevs.photoncamera.ui.camera.views.settingsbar.SettingsBarLayout
                android:id="@+id/settings_bar"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                android:elevation="@dimen/standard_20"
                app:bindRotate="@{uimodel}"
                app:layout_constraintBottom_toTopOf="@id/layout_bottombar"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_max="300dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:settingsBarVisibility="@{uimodel.settingsBarVisibility}" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <include
        android:id="@+id/layout_topbar"
        layout="@layout/layout_main_topbar"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:visibility="@{uimodel.settingsBarVisibility ? View.INVISIBLE : View.VISIBLE}"
        app:adjustTopBar="@{uimodel.screenAspectRatio}"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/arrow_top"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/aux_container_background"
        android:backgroundTint="@color/panel_transparency"
        android:clickable="true"
        android:onClick="@{()-> uimodel.setSettingsBarVisibility(!uimodel.settingsBarVisibility)}"
        android:rotation="180"
        android:src="@drawable/chevron_up"
        android:visibility="@{uimodel.settingsBarVisibility ? View.INVISIBLE : View.VISIBLE}"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_topbar"
        app:layout_constraintVertical_bias="0" />

</androidx.constraintlayout.widget.ConstraintLayout>
</layout>
