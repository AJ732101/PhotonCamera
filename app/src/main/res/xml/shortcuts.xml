<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="open_gallery"
        android:enabled="true"
        android:icon="@mipmap/ic_gallery_launcher"
        android:shortcutShortLabel="@string/gallery_name"
        android:shortcutLongLabel="@string/gallery_name" >
        <intent
            android:action="com.particlesdevs.photoncamera.action.OPEN_GALLERY"
            android:targetClass="com.particlesdevs.photoncamera.ui.ShortcutDispatcherActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="select_gallery"
        android:enabled="true"
        android:icon="@mipmap/ic_gallery_launcher"
        android:shortcutShortLabel="@string/select_gallery"
        android:shortcutLongLabel="@string/select_gallery" >
        <intent
            android:action="com.particlesdevs.photoncamera.action.SELECT_GALLERY"
            android:targetClass="com.particlesdevs.photoncamera.ui.ShortcutDispatcherActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="open_settings"
        android:enabled="true"
        android:icon="@drawable/ic_settings"
        android:shortcutShortLabel="@string/settings"
        android:shortcutLongLabel="@string/settings" >
        <intent
            android:action="com.particlesdevs.photoncamera.action.OPEN_SETTINGS"
            android:targetClass="com.particlesdevs.photoncamera.ui.ShortcutDispatcherActivity" />
    </shortcut>
</shortcuts>
