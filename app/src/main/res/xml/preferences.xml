<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:orderingFromXml="true"
        android:title="@string/settings"
        android:key="prefscreen">
    <PreferenceCategory
            android:layout="@layout/preference_category_layout"
            android:key="@string/pref_category_general_key"
            android:title="@string/general">
        <com.particlesdevs.photoncamera.ui.settings.custompreferences.UniversalSeekBarPreference
                android:key="@string/pref_frame_count_key"
                android:layout="@layout/preference_seekbar"
                android:title="@string/frame_count"
                android:defaultValue="@string/pref_framecount_default"
                app:maxValue="200"
                app:minValue="1"
                android:icon="@drawable/ic_burst_mode_black_24dp"/>
        <com.particlesdevs.photoncamera.ui.settings.custompreferences.ManagedSwitchPreference
                android:key="@string/pref_wide169_key"
                android:defaultValue="@bool/pref_wide169_default"
                android:layout="@layout/preference_with_margin"
                android:title="@string/wide169"
                android:summary=""
                android:icon="@drawable/ic_burst_mode_black_24dp"/>
        <com.particlesdevs.photoncamera.ui.settings.custompreferences.ManagedSwitchPreference
                android:key="@string/pref_energy_safe_key"
                android:defaultValue="@bool/pref_energy_safe_default"
                android:layout="@layout/preference_with_margin"
                android:title="@string/energy_saving"
                android:summary=""
                android:icon="@drawable/leaf_icon_15"/>
        <com.particlesdevs.photoncamera.ui.settings.custompreferences.ManagedSwitchPreference
                android:key="@string/pref_camera_sounds_key"
                android:defaultValue="@bool/pref_camera_sounds_default"
                android:layout="@layout/preference_with_margin"
                android:title="@string/camera_sounds"
                android:summary=""
                android:icon="@drawable/ic_camera_sounds"/>
        <ListPreference
                android:key="@string/pref_show_grid_key"
                android:defaultValue="@string/pref_show_grid_default"
                android:layout="@layout/preference_with_margin"
                android:title="@string/turn_on_grid"
                app:useSimpleSummaryProvider="true"
                android:summary=""
                android:entries="@array/vf_grid_entries"
                android:entryValues="@array/vf_grid_entryvalues"
                android:icon="@drawable/ic_settings_grid"/>
        <com.particlesdevs.photoncamera.ui.settings.custompreferences.ManagedSwitchPreference
                android:key="@string/pref_show_roundedge_key"
                android:defaultValue="@bool/pref_show_roundedge_default"
                android:layout="@layout/preference_with_margin"
                android:title="@string/turn_on_round_edges"
                android:summary=""
                android:icon="@drawable/ic_rounded_corner"/>
        <com.particlesdevs.photoncamera.ui.settings.custompreferences.ManagedSwitchPreference
                android:key="@string/pref_show_watermark_key"
                android:defaultValue="@bool/pref_show_watermark_default"
                android:layout="@layout/preference_with_margin"
                android:title="@string/turn_on_watermark"
                android:summary=""
                android:icon="@drawable/ic_watermark"/>
        <ListPreference
                android:layout="@layout/preference_with_margin"
                android:key="@string/pref_af_mode_key"
                android:title="@string/af_mode"
                app:useSimpleSummaryProvider="true"
                android:icon="@drawable/ic_focus"
                android:entries="@array/af_mode_entries"
                android:entryValues="@array/af_mode_entryvalues"
                android:defaultValue="@string/pref_af_mode_default_value"/>
        <com.particlesdevs.photoncamera.ui.settings.custompreferences.ManagedSwitchPreference
                android:layout="@layout/preference_with_margin"
                android:key="@string/pref_ois_key"
                android:defaultValue="@bool/pref_ois_default"
                android:title="@string/turn_on_ois"
                android:summary=""
                android:icon="@drawable/video_stable_24px"/>
        <ListPreference
                android:layout="@layout/preference_with_margin"
                android:key="@string/pref_aperture_key"
                android:title="@string/aperture"
                app:useSimpleSummaryProvider="true"
                android:icon="@drawable/camera_24px"
                android:entries="@array/aperture_entries"
                android:entryValues="@array/aperture_entryValues"
                android:defaultValue="@string/pref_aperture_default_value" />
        <com.particlesdevs.photoncamera.ui.settings.custompreferences.ManagedSwitchPreference
                android:layout="@layout/preference_with_margin"
                android:key="@string/pref_dng_compression_key"
                android:defaultValue="@bool/pref_dng_compression_default"
                android:title="@string/turn_on_dng_compression"
                android:summary=""
                android:icon="@drawable/compress_24px"/>
        <com.particlesdevs.photoncamera.ui.settings.custompreferences.ManagedSwitchPreference
                android:layout="@layout/preference_with_margin"
                android:key="@string/pref_extend_iso_key"
                android:defaultValue="@bool/pref_extend_iso_default"
                android:title="@string/turn_on_extend_iso"
                android:summary=""
                android:icon="@drawable/exposure_24px"/>
        <com.particlesdevs.photoncamera.ui.settings.custompreferences.ManagedSwitchPreference
                android:layout="@layout/preference_with_margin"
                android:key="@string/pref_extend_exposure_key"
                android:defaultValue="@bool/pref_extend_exposure_default"
                android:title="@string/turn_on_extend_exposure"
                android:summary=""
                android:icon="@drawable/ic_timer"/>
        <com.particlesdevs.photoncamera.ui.settings.custompreferences.ManagedSwitchPreference
                android:layout="@layout/preference_with_margin"
                android:key="@string/pref_show_afdata_key"
                android:defaultValue="@bool/pref_show_afdata_default"
                android:title="@string/turn_on_afdata"
                android:summary=""
                android:icon="@drawable/ic_developer"/>
        <com.particlesdevs.photoncamera.ui.settings.custompreferences.ManagedSwitchPreference
                android:layout="@layout/preference_with_margin"
                android:key="@string/pref_show_basic_osd_key"
                android:defaultValue="@bool/pref_show_basic_osd_default"
                android:title="@string/turn_on_basic_osd"
                android:summary=""
                android:icon="@drawable/ic_developer"/>
        <com.particlesdevs.photoncamera.ui.settings.custompreferences.ManagedSwitchPreference
                android:title="@string/pref_save_per_lens_string"
                android:layout="@layout/preference_with_margin"
                android:key="@string/pref_save_per_lens_settings"
                android:icon="@drawable/ic_multi_lens"
                app:defaultValue="false"/>
    </PreferenceCategory>
    <PreferenceCategory
            android:layout="@layout/preference_category_layout"
            android:key="@string/pref_category_jpg_key"
            android:title="@string/jpg">
        <com.particlesdevs.photoncamera.ui.settings.custompreferences.ManagedSwitchPreference
                android:key="@string/pref_enable_system_nr_key"
                android:defaultValue="@bool/pref_system_nr_default"
                android:layout="@layout/preference_with_margin"
                android:title="@string/turn_on_system_nr"
                android:summary=""
                android:icon="@drawable/ic_gradient_black_24dp"/>
        <com.particlesdevs.photoncamera.ui.settings.custompreferences.ManagedSwitchPreference
                android:key="@string/pref_disable_aligning_key"
                android:defaultValue="@bool/pref_disable_align_default"
                android:layout="@layout/preference_with_margin"
                android:title="@string/disable_aligning"
                android:summary=""
                android:icon="@drawable/ic_format_align_justify_black_24dp"/>
        <com.particlesdevs.photoncamera.ui.settings.custompreferences.UniversalSeekBarPreference
                android:key="@string/pref_chroma_nr_seekbar_key"
                android:layout="@layout/preference_seekbar"
                android:title="@string/chroma_nr_count"
                android:summary=""
                android:defaultValue="@string/pref_chroma_seekbar_default"
                app:maxValue="65"
                app:minValue="1"
                android:icon="@drawable/ic_burst_mode_black_24dp"/>
        <com.particlesdevs.photoncamera.ui.settings.custompreferences.UniversalSeekBarPreference
                android:key="@string/pref_luma_nr_seekbar_key"
                android:layout="@layout/preference_seekbar"
                android:title="@string/luma_nr_count"
                android:summary=""
                android:defaultValue="@string/pref_luma_seekbar_default"
                app:maxValue="65"
                app:minValue="1"
                android:icon="@drawable/ic_grain_black_24dp"/>
        <com.particlesdevs.photoncamera.ui.settings.custompreferences.ManagedSwitchPreference
                android:key="@string/pref_enhanced_processing_key"
                android:defaultValue="@bool/pref_enhanced_processing_default"
                android:layout="@layout/preference_with_margin"
                android:title="@string/enhanced_processing"
                android:summary=""
                android:icon="@drawable/ic_tune_black_24dp"/>
    </PreferenceCategory>
    <PreferenceCategory
            android:layout="@layout/preference_category_layout"
            android:key="@string/pref_category_hdrx_key"
            android:title="@string/hdrx">
        <ListPreference
                android:layout="@layout/preference_with_margin"
                android:key="@string/pref_save_raw_key"
                android:title="@string/raw"
                app:useSimpleSummaryProvider="true"
                android:icon="@drawable/ic_raw"
                android:summary=""
                android:entries="@array/raw_mode_entries"
                android:entryValues="@array/raw_mode_entryvalues"
                android:defaultValue="@string/pref_raw_mode_default_value"/>
        <com.particlesdevs.photoncamera.ui.settings.custompreferences.ManagedSwitchPreference
                android:key="@string/pref_hdrx_nr_key"
                android:defaultValue="@bool/pref_hdrx_nr_default"
                android:layout="@layout/preference_with_margin"
                android:title="@string/hdrxNR"
                android:summary=""
                android:icon="@drawable/ic_gradient_black_24dp"/>
        <com.particlesdevs.photoncamera.ui.settings.custompreferences.UniversalSeekBarPreference
                android:key="@string/pref_sharpness_seekbar_key"
                android:layout="@layout/preference_seekbar"
                android:title="@string/sharpness"
                android:summary=""
                android:defaultValue="@string/pref_sharpness_seekbar_default"
                app:maxValue="1.0"
                app:minValue="-0.2"
                app:isFloat="true"
                app:stepPerUnit="20"
                android:icon="@drawable/ic_grain_black_24dp"/>
        <com.particlesdevs.photoncamera.ui.settings.custompreferences.UniversalSeekBarPreference
                android:key="@string/pref_saturation_seekbar_key"
                android:layout="@layout/preference_seekbar"
                android:title="@string/saturation"
                android:summary=""
                android:defaultValue="@string/pref_saturation_seekbar_default"
                app:maxValue="3"
                app:minValue="0"
                app:isFloat="true"
                app:stepPerUnit="10"
                android:icon="@drawable/ic_saturation"/>
        <com.particlesdevs.photoncamera.ui.settings.custompreferences.UniversalSeekBarPreference
                android:key="@string/pref_contrast_seekbar_key"
                android:layout="@layout/preference_seekbar"
                android:title="@string/contrast"
                android:summary=""
                android:defaultValue="@string/pref_contrast_seekbar_default"
                app:maxValue="3"
                app:minValue="0"
                app:isFloat="true"
                app:stepPerUnit="10"
                android:icon="@drawable/ic_saturation"/>
        <com.particlesdevs.photoncamera.ui.settings.custompreferences.UniversalSeekBarPreference
                android:key="@string/pref_expocompensation_seekbar_key"
                android:layout="@layout/preference_seekbar"
                android:title="@string/expocompensation"
                android:summary=""
                android:defaultValue="@string/pref_expocompensation_seekbar_default"
                app:maxValue="4"
                app:minValue="-4"
                app:isFloat="true"
                app:stepPerUnit="10"
                android:icon="@drawable/ic_saturation"/>
        <com.particlesdevs.photoncamera.ui.settings.custompreferences.UniversalSeekBarPreference
                android:key="@string/pref_noise_seekbar_key"
                android:layout="@layout/preference_seekbar"
                android:title="@string/noise_reduction_str"
                android:summary=""
                android:defaultValue="@string/pref_noise_seekbar_default"
                app:maxValue="4"
                app:minValue="-6"
                app:isFloat="true"
                app:stepPerUnit="10"
                android:icon="@drawable/ic_compressor"/>
        <com.particlesdevs.photoncamera.ui.settings.custompreferences.UniversalSeekBarPreference
                android:key="@string/pref_merge_seekbar_key"
                android:layout="@layout/preference_seekbar"
                android:title="@string/noise_merge_str"
                android:summary=""
                android:defaultValue="@string/pref_noise_merge_seekbar_default"
                app:maxValue="8"
                app:minValue="-4"
                app:isFloat="true"
                app:stepPerUnit="10"
                android:icon="@drawable/ic_compressor"/>
        <com.particlesdevs.photoncamera.ui.settings.custompreferences.UniversalSeekBarPreference
                android:key="@string/pref_shadows_seekbar_key"
                android:layout="@layout/preference_seekbar"
                android:title="@string/shadows"
                android:summary=""
                android:defaultValue="@string/pref_gain_seekbar_default"
                app:maxValue="2.0"
                app:minValue="-1.0"
                app:isFloat="true"
                app:stepPerUnit="10"
                android:icon="@drawable/ic_compressor"/>
        <com.particlesdevs.photoncamera.ui.settings.custompreferences.UniversalSeekBarPreference
                android:key="@string/pref_compressor_seekbar_key"
                android:layout="@layout/preference_seekbar"
                android:title="@string/compressor"
                android:summary=""
                android:defaultValue="@string/pref_compressor_seekbar_default"
                app:maxValue="8.0"
                app:minValue="-1.0"
                app:isFloat="true"
                app:stepPerUnit="10"
                android:icon="@drawable/ic_compressor"/>
        <ListPreference
                android:layout="@layout/preference_with_margin"
                android:key="@string/pref_cfa_key"
                android:title="@string/cfa"
                app:useSimpleSummaryProvider="true"
                android:icon="@drawable/ic_bayer"
                android:entries="@array/cfapat_entries"
                android:entryValues="@array/cfapat_entryValues"
                android:defaultValue="@string/pref_cfa_default_value"/>
        <ListPreference
                android:layout="@layout/preference_with_margin"
                android:key="@string/pref_align_method_key"
                app:useSimpleSummaryProvider="true"
                android:title="@string/align_method"
                android:icon="@drawable/ic_burst_mode_black_24dp"
                android:entries="@array/alignset_entries"
                android:entryValues="@array/alignset_entryValues"
                android:defaultValue="@string/pref_align_method_default"/>
        <ListPreference
                android:layout="@layout/preference_with_margin"
                android:key="@string/pref_color_method_key"
                app:useSimpleSummaryProvider="true"
                android:title="@string/color_method"
                android:icon="@drawable/ic_saturation"
                android:entries="@array/colorset_entries"
                android:entryValues="@array/colorset_entryValues"
                android:defaultValue="@string/pref_align_method_default"/>
        <ListPreference
                android:layout="@layout/preference_with_margin"
                android:key="@string/pref_peak_method_key"
                app:useSimpleSummaryProvider="true"
                android:title="@string/focus_peaking"
                android:icon="@drawable/ic_saturation"
                android:entries="@array/focuspeakset_entries"
                android:entryValues="@array/focuspeakset_entryValues"
                android:defaultValue="@string/pref_focus_peak_default"/>
        <ListPreference
                android:layout="@layout/preference_with_margin"
                android:key="@string/pref_preview_format_key"
                app:useSimpleSummaryProvider="true"
                android:title="@string/preview_format"
                android:icon="@drawable/ic_saturation"
                android:entries="@array/preview_format_entries"
                android:entryValues="@array/preview_format_entryValues"
                android:defaultValue="@string/pref_preview_format_default"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:layout="@layout/preference_category_layout"
        android:key="@string/pref_theme_category_key"
        android:title="@string/theme">
        <ListPreference
            android:layout="@layout/preference_with_margin"
            android:key="@string/pref_theme_key"
            android:title="@string/theme"
            app:useSimpleSummaryProvider="true"
            android:icon="@drawable/ic_theme"
            android:entries="@array/theme_entries"
            android:entryValues="@array/theme_entryValues"
            android:defaultValue="@string/pref_theme_default_value" />
        <ListPreference
            android:layout="@layout/preference_with_margin"
            android:key="@string/pref_theme_accent_key"
            android:title="@string/theme_accent"
            app:useSimpleSummaryProvider="true"
            android:icon="@drawable/ic_saturation"
            android:entries="@array/theme_accent_entries"
            android:entryValues="@array/theme_accent_entryValues"
            android:defaultValue="@string/pref_theme_accent_default_value"/>
        <com.particlesdevs.photoncamera.ui.settings.custompreferences.ManagedSwitchPreference
            android:layout="@layout/preference_with_margin"
            android:key="@string/pref_show_gradient_key"
            android:title="@string/show_gradient"
            android:summary=""
            android:icon="@drawable/ic_gradient_black_24dp"
            android:defaultValue="@bool/pref_show_gradient_def_value"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:layout="@layout/preference_category_layout"
        android:key="@string/pref_category_video_key"
        android:title="@string/video">
        <com.particlesdevs.photoncamera.ui.settings.custompreferences.UniversalSeekBarPreference
            android:key="@string/pref_bitrate_key"
            android:layout="@layout/preference_seekbar"
            android:title="@string/bitrate"
            android:defaultValue="@string/pref_bitrate_default"
            app:maxValue="200"
            app:minValue="10"
            android:icon="@drawable/speed_24px"/>
        <ListPreference
            android:layout="@layout/preference_with_margin"
            android:key="@string/pref_codec_key"
            android:title="@string/codec"
            app:useSimpleSummaryProvider="true"
            android:icon="@drawable/compress_24px"
            android:entries="@array/codec_entries"
            android:entryValues="@array/codec_entryValues"
            android:defaultValue="@string/pref_codec_default_value" />
        <ListPreference
            android:layout="@layout/preference_with_margin"
            android:key="@string/pref_video_resolution_key"
            android:title="@string/video_resolution"
            app:useSimpleSummaryProvider="true"
            android:icon="@drawable/display_settings_24px"
            android:entries="@array/video_resolution_entries"
            android:entryValues="@array/video_resolution_entryValues"
            android:defaultValue="@string/pref_video_resolution_default_value" />
        <ListPreference
            android:layout="@layout/preference_with_margin"
            android:key="@string/pref_video_framerate_key"
            android:title="@string/video_framerate"
            app:useSimpleSummaryProvider="true"
            android:icon="@drawable/fps30fps_24px"
            android:entries="@array/video_framerate_entries"
            android:entryValues="@array/video_framerate_entryValues"
            android:defaultValue="@string/pref_video_framerate_default_value" />
        <ListPreference
            android:layout="@layout/preference_with_margin"
            android:key="@string/pref_noise_processing_key"
            android:title="@string/noise_processing"
            app:useSimpleSummaryProvider="true"
            android:icon="@drawable/transition_dissolve_24px"
            android:entries="@array/noise_processing_entries"
            android:entryValues="@array/noise_processing_entryValues"
            android:defaultValue="@string/pref_noise_processing_default_value" />
        <ListPreference
            android:layout="@layout/preference_with_margin"
            android:key="@string/pref_edge_processing_key"
            android:title="@string/edge_processing"
            app:useSimpleSummaryProvider="true"
            android:icon="@drawable/e_mobiledata_badge_24px"
            android:entries="@array/edge_processing_entries"
            android:entryValues="@array/edge_processing_entryValues"
            android:defaultValue="@string/pref_edge_processing_default_value" />
        <com.particlesdevs.photoncamera.ui.settings.custompreferences.ManagedSwitchPreference
            android:layout="@layout/preference_with_margin"
            android:key="@string/pref_hdr_video_key"
            android:title="@string/hdr_video"
            android:summary=""
            android:icon="@drawable/hdr_on_24px"
            android:defaultValue="@bool/pref_hdr_video_def_value"/>
        <com.particlesdevs.photoncamera.ui.settings.custompreferences.ManagedSwitchPreference
            android:layout="@layout/preference_with_margin"
            android:key="@string/pref_10bit_video_key"
            android:title="@string/video_10bit"
            android:summary=""
            android:icon="@drawable/high_quality_24px"
            android:defaultValue="@bool/pref_10bit_video_def_value"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:layout="@layout/preference_category_layout"
        android:key="@string/pref_category_audio_key"
        android:title="@string/audio">
        <com.particlesdevs.photoncamera.ui.settings.custompreferences.UniversalSeekBarPreference
            android:key="@string/pref_audio_bitrate_key"
            android:layout="@layout/preference_seekbar"
            android:title="@string/audio_bitrate"
            android:defaultValue="@string/pref_audio_bitrate_default"
            app:maxValue="192"
            app:minValue="32"
            android:icon="@drawable/speed_24px"/>
        <ListPreference
            android:layout="@layout/preference_with_margin"
            android:key="@string/pref_audio_processing_key"
            android:title="@string/audio_processing"
            app:useSimpleSummaryProvider="true"
            android:icon="@drawable/mic_24px"
            android:entries="@array/audio_processing_entries"
            android:entryValues="@array/audio_processing_entryValues"
            android:defaultValue="@string/pref_edge_processing_default_value" />
        <ListPreference
            android:layout="@layout/preference_with_margin"
            android:key="@string/pref_audio_codec_key"
            android:title="@string/audio_codec"
            app:useSimpleSummaryProvider="true"
            android:icon="@drawable/compress_24px"
            android:entries="@array/audio_codec_entries"
            android:entryValues="@array/audio_codec_entryValues"
            android:defaultValue="@string/pref_audio_codec_default_value" />
        <ListPreference
            android:layout="@layout/preference_with_margin"
            android:key="@string/pref_audio_channels_key"
            android:title="@string/audio_channels"
            app:useSimpleSummaryProvider="true"
            android:icon="@drawable/surround_sound_24px"
            android:entries="@array/audio_channels_entries"
            android:entryValues="@array/audio_channels_entryValues"
            android:defaultValue="@string/pref_audio_channels_default_value" />
        <ListPreference
            android:layout="@layout/preference_with_margin"
            android:key="@string/pref_sps_key"
            android:title="@string/sps"
            app:useSimpleSummaryProvider="true"
            android:icon="@drawable/cadence_24px"
            android:entries="@array/sps_entries"
            android:entryValues="@array/sps_entryValues"
            android:defaultValue="@string/pref_sps_default_value" />
    </PreferenceCategory>
    <PreferenceCategory
            android:layout="@layout/preference_category_layout"
            android:key="@string/pref_category_backup_restore"
            android:title="@string/backup_restore">
        <com.particlesdevs.photoncamera.ui.settings.custompreferences.BackupPreferences
                android:icon="@drawable/ic_save"
                android:layout="@layout/preference_with_margin"
                android:title="@string/backup"
                android:key="@string/pref_backup_preferences_key"/>
        <com.particlesdevs.photoncamera.ui.settings.custompreferences.RestorePreference
                android:icon="@drawable/ic_restore"
                android:layout="@layout/preference_with_margin"
                android:title="@string/restore"
                android:key="@string/pref_restore_preferences_key"/>
        <com.particlesdevs.photoncamera.ui.settings.custompreferences.ResetPreferences
                android:icon="@drawable/ic_refresh"
                android:layout="@layout/preference_with_margin"
                android:title="@string/reset"
                android:key="@string/pref_reset_preferences_key"/>
    </PreferenceCategory>
    <PreferenceCategory
            android:layout="@layout/preference_category_layout"
            android:key="@string/pref_category_about_key"
            android:title="@string/about">
        <PreferenceScreen
                android:layout="@layout/preference_with_margin"
                android:title="@string/about"
                android:key="@string/pref_about_key"
                android:icon="@drawable/ic_baseline_info_24">
            <Preference
                android:layout="@layout/preference_about"
                android:title="@string/app_name"
                android:summary="@string/photon_camera_summary"
                android:key="@string/pref_photoncamera"
                android:enabled="false"
                android:icon="@drawable/ic_splash">
            </Preference>
            <Preference
                android:key="@string/pref_version_key"
                android:title="@string/version_title"
                android:layout="@layout/preference_about"
                android:summary="@string/version_summary"
                android:enabled="false"/>
            <Preference
                android:layout="@layout/preference_about"
                app:singleLineTitle="true"
                android:enabled="false"
                android:persistent="false"
                android:key="@string/pref_this_device_key"/>
            <Preference
                android:layout="@layout/preference_about"
                android:key="@string/pref_contributors_key"
                android:icon="@drawable/ic_github"
                android:title="@string/contributors_title"
                android:summary="eszdman, assasinfil, killerink, mirai, Urnyx05, vibhorSrv, snajdovski"/>
            <Preference
                android:layout="@layout/preference_about"
                android:title="@string/telegram"
                android:icon="@drawable/ic_telegram"
                android:key="@string/pref_telegram_channel_key"/>
            <Preference
                android:layout="@layout/preference_about"
                android:title="@string/supported_devices"
                android:enabled="false"
                android:persistent="false"
                android:key="@string/all_devices_names"/>
        </PreferenceScreen>
    </PreferenceCategory>
</PreferenceScreen>